# ~/.zshrc —— 跨平台（macOS / Linux），由 personal-systemconfig 管理
# 插件管理：zinit（取代 oh-my-zsh + git clone）
# Node 版本管理：fnm（取代 nvm）

# ---------------------------------------------------------------------------
# 基础 PATH
# ---------------------------------------------------------------------------
export PATH="$HOME/.local/bin:$PATH"

# ---------------------------------------------------------------------------
# Homebrew 环境（仅 macOS；Apple Silicon 在 /opt/homebrew，Intel 在 /usr/local）
# ---------------------------------------------------------------------------
if [[ "$OSTYPE" == darwin* ]]; then
  if [[ -x /opt/homebrew/bin/brew ]]; then
    eval "$(/opt/homebrew/bin/brew shellenv)"
  elif [[ -x /usr/local/bin/brew ]]; then
    eval "$(/usr/local/bin/brew shellenv)"
  fi
fi

# ---------------------------------------------------------------------------
# zinit 引导（首次会自动克隆）
# ---------------------------------------------------------------------------
ZINIT_HOME="${XDG_DATA_HOME:-$HOME/.local/share}/zinit/zinit.git"
if [[ ! -d "$ZINIT_HOME" ]]; then
  command mkdir -p "$(dirname "$ZINIT_HOME")"
  command git clone https://github.com/zdharma-continuum/zinit.git "$ZINIT_HOME"
fi
source "$ZINIT_HOME/zinit.zsh"

# ---------------------------------------------------------------------------
# 主题：agnoster（通过 zinit 加载 oh-my-zsh 的库与主题文件）
#   agnoster 需要 Powerline / Nerd 字体；kitty 配置已使用 JetBrains Mono
# ---------------------------------------------------------------------------
zinit snippet OMZL::git.zsh
zinit snippet OMZL::theme-and-appearance.zsh
ZSH_THEME="agnoster"
zinit snippet OMZT::agnoster

# ---------------------------------------------------------------------------
# 插件（迁移自原 plugins=(git z zsh-autosuggestions zsh-syntax-highlighting npm vscode)）
# ---------------------------------------------------------------------------
zinit snippet OMZP::git
zinit snippet OMZP::z
zinit snippet OMZP::npm
zinit snippet OMZP::vscode

zinit light zsh-users/zsh-completions
zinit light zsh-users/zsh-autosuggestions

# 补全初始化（须在加载 completions 之后、syntax-highlighting 之前）
autoload -Uz compinit && compinit
zinit cdreplay -q

# 语法高亮必须最后加载
zinit light zsh-users/zsh-syntax-highlighting

# ---------------------------------------------------------------------------
# fnm —— Node 版本管理（取代 nvm）
# ---------------------------------------------------------------------------
# Linux 官方安装器路径
[[ -d "$HOME/.local/share/fnm" ]] && export PATH="$HOME/.local/share/fnm:$PATH"
if command -v fnm >/dev/null 2>&1; then
  eval "$(fnm env --use-on-cd)"
fi

